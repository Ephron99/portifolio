# Copy this file to .env (same folder) and fill in real values, then restart the dev server.
# All keys are optional — the site works without them; features that need a
# key show a visible notice instead of failing silently.

# Contact form delivery. Use ONE of the following (see README "Contact Form"):
#   1. Formspree (https://formspree.io) — free tier, no backend needed.
#   2. Your own API endpoint (any POST endpoint accepting JSON).
VITE_FORMSPREE_ENDPOINT=
VITE_CONTACT_ENDPOINT=
